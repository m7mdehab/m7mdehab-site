{
  "version": "1.0.0",
  "date": "2026-10-03",
  "authority": "Mohammed Ehab ElNomany",
  "status": "design-locked-ready-for-implementation",
  "section": {
    "id": "method",
    "dataAttribute": "data-method-story",
    "eyebrow": "APPROACH",
    "headline": "I turn messy reality into reliable systems.",
    "support": "I make unclear problems legible, reduce ambiguity, then build the smallest system that can carry the job.",
    "cta": {
      "label": "Inspect the evidence",
      "href": "/work"
    }
  },
  "narrative": [
    {
      "id": "messy",
      "title": "Messy reality",
      "detail": "Fragmented, inconsistent and unclear."
    },
    {
      "id": "expose",
      "title": "Expose the truth",
      "detail": "Surface evidence, constraints and unknowns."
    },
    {
      "id": "reduce",
      "title": "Reduce ambiguity",
      "detail": "Turn fuzzy questions into explicit mappings and decisions."
    },
    {
      "id": "build",
      "title": "Build the system",
      "detail": "Create the smallest reliable system that works in practice."
    },
    {
      "id": "outcomes",
      "title": "Reliable outcomes",
      "detail": "Validated, usable and ready for real use."
    }
  ],
  "inputs": [
    "Fragmented data",
    "Conflicting definitions",
    "Missing context",
    "Incomplete evidence"
  ],
  "exposeTags": [
    "Evidence",
    "Constraints",
    "Unknowns"
  ],
  "outputs": [
    "Validated migration",
    "Decision-ready analytics",
    "Evaluated model",
    "Governed AI workflow",
    "Usable product"
  ],
  "statusLabel": "DECISION-READY",
  "implementation": {
    "animationLibrary": "motion/react",
    "addDependencies": false,
