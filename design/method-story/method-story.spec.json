    "iconFile": "components/method-story-icons.tsx",
    "stylesheet": "app/method-story.css",
    "testFile": "tests/frontend-overhaul-phase-f.spec.ts",
    "legacyCssDeletionInSamePass": false
  },
  "breakpoints": {
